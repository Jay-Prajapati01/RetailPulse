FROM python:3.10-slim

WORKDIR /opt/mlflow

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir mlflow gunicorn psycopg2-binary

ENV MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db
ENV MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts

VOLUME ["/mlflow"]
EXPOSE 5000

CMD ["/bin/sh", "-c", "mlflow server --backend-store-uri \"${MLFLOW_BACKEND_STORE_URI}\" --default-artifact-root \"${MLFLOW_DEFAULT_ARTIFACT_ROOT}\" --host 0.0.0.0 --port 5000"]
